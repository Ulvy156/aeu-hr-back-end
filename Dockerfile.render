# syntax=docker/dockerfile:1
FROM php:8.3-fpm-alpine

# Faster PHP extension installer — compiles extensions and auto-removes build deps
ADD --chmod=0755 \
    https://github.com/mlocati/docker-php-extension-installer/releases/latest/download/install-php-extensions \
    /usr/local/bin/

# PHP extensions — cached between builds via BuildKit mount
RUN --mount=type=cache,target=/tmp/ipe-cache \
    IPE_CACHE_DIR=/tmp/ipe-cache install-php-extensions \
        pdo_pgsql pgsql mbstring xml dom gd zip bcmath intl opcache exif pcntl fileinfo

# PHP runtime settings
RUN printf "opcache.enable=1\nopcache.memory_consumption=256\nopcache.max_accelerated_files=20000\nopcache.validate_timestamps=0\n" \
        > /usr/local/etc/php/conf.d/opcache.ini \
    && printf "upload_max_filesize=50M\npost_max_size=50M\nmemory_limit=256M\n" \
        > /usr/local/etc/php/conf.d/limits.ini

# Runtime system packages only (nginx, supervisor, envsubst, pg_dump for backups)
RUN --mount=type=cache,target=/etc/apk/cache \
    apk add nginx supervisor gettext postgresql-client

# Composer binary
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

# Install PHP dependencies first — cached as long as composer.json/lock don't change
COPY composer.json composer.lock ./
RUN --mount=type=cache,target=/root/.composer/cache \
    composer install --no-dev --optimize-autoloader --no-interaction --no-scripts

# Application source — this layer changes most often, so it goes last
COPY . .
RUN composer run-script post-autoload-dump

# Writable directories only — avoids slow recursive chown on vendor
RUN chown -R www-data:www-data storage bootstrap/cache \
    && chmod -R 775 storage bootstrap/cache

# Configs and entrypoint
RUN rm -f /etc/nginx/http.d/default.conf
COPY docker/nginx/render.conf.template /etc/nginx/templates/default.conf.template
COPY docker/supervisord.conf /etc/supervisord.conf
COPY docker/entrypoint.render.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 10000

ENTRYPOINT ["/entrypoint.sh"]
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisord.conf"]
